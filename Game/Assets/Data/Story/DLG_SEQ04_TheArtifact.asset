  m_Script: {fileID: 11500000, guid: 50060b8dc62b41a419acff01334cb145, type: 3}
  m_Name: DLG_SEQ04_TheArtifact
  m_EditorClassIdentifier: Assembly-CSharp::Bayani.Story.DialogueAsset
  lines:
  - speaker: NARRATION
    text: Inside the ruins, Kai discovers ancient markings. One symbol matches the
      artifact.
  - speaker: NARRATION
    text: "Visions \u2014 ocean. Ancient boats. Warriors. A village. Foreign ships.
      Fire."
  - speaker: NARRATION
    text: A man standing on the shore.
  - speaker: NARRATION
    text: Kai drops the artifact. Then it starts moving by itself. THUMP. THUMP.
      Like a heartbeat.
