  m_Script: {fileID: 11500000, guid: 50060b8dc62b41a419acff01334cb145, type: 3}
  m_Name: DLG_SEQ06_Arrival
  m_EditorClassIdentifier: Assembly-CSharp::Bayani.Story.DialogueAsset
  lines:
  - speaker: NARRATION
    text: "Kai wakes up on a beach. Not the ruin-coast \u2014 a different shoreline,
      an older sea."
  - speaker: NARRATION
    text: I had read about this moment.
  - speaker: NARRATION
    text: Ships from another world arrived in our islands.
  - speaker: NARRATION
    text: But history had always been words on a page.
  - speaker: NARRATION
    text: Now...
  - speaker: NARRATION
    text: I was standing inside it.
  - speaker: VILLAGER
    text: The strangers have arrived.
  - speaker: KAI
    text: This is Cebu.
