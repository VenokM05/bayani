  m_Script: {fileID: 11500000, guid: 50060b8dc62b41a419acff01334cb145, type: 3}
  m_Name: DLG_SEQ07B_Intro
  m_EditorClassIdentifier: Assembly-CSharp::Bayani.Story.DialogueAsset
  lines:
  - speaker: NARRATION
    text: Night. Kai is shown to a shelter by a Cebuano family.
  - speaker: NARRATION
    text: The firelight flickers wrong. The shadows peel off the walls.
  - speaker: NARRATION
    text: Something formless comes for Kai.
  - speaker: ELDER
    text: The anito of forgotten places grow bold when strangers carry old light.
  - speaker: NARRATION
    text: "The artifact flares \u2014 and holds the shadow at bay. Fight it. Learn
      it. You cannot fall here."
