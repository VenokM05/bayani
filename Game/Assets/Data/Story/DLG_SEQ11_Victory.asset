  m_Script: {fileID: 11500000, guid: 50060b8dc62b41a419acff01334cb145, type: 3}
  m_Name: DLG_SEQ11_Victory
  m_EditorClassIdentifier: Assembly-CSharp::Bayani.Story.DialogueAsset
  lines:
  - speaker: NARRATION
    text: Every ambient sound rushes back into the hole at once. Drums. Surf. Screams.
      The battle keeps its shape.
  - speaker: NARRATION
    text: "The shape is driven out of this memory \u2014 down, deeper, into the bloodline.
      Not killed. Never killed."
  - speaker: TALA
    text: "Codex: ANOMALY \u2014 apex of the Limot family. The entry is 90% blank.
      Flagging the missing data as itself the anomaly."
  - speaker: NARRATION
    text: "On the tideline, Kai's ancestor is still standing. Wounded \u2014 alive.
      (SEQ 12 \u2014 the goodbye \u2014 continues.)"
  xpReward: 0
