  m_Script: {fileID: 11500000, guid: 50060b8dc62b41a419acff01334cb145, type: 3}
  m_Name: DLG_SEQ11_Reaching
  m_EditorClassIdentifier: Assembly-CSharp::Bayani.Story.DialogueAsset
  lines:
  - speaker: NARRATION
    text: "The last seam closes \u2014 and the shape turns from the fighters and
      reaches for the event itself."
  - speaker: NARRATION
    text: The artifact burns against Kai's chest. The pull-back has begun, with or
      without consent.
  - speaker: KAI
    text: Not yet!
  - speaker: NARRATION
    text: Kai cannot stay. The last burst is all that is left of choice.
  xpReward: 0
