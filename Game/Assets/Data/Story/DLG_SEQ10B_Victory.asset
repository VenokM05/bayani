  m_Script: {fileID: 11500000, guid: 50060b8dc62b41a419acff01334cb145, type: 3}
  m_Name: DLG_SEQ10B_Victory
  m_EditorClassIdentifier: Assembly-CSharp::Bayani.Story.DialogueAsset
  lines:
  - speaker: NARRATION
    text: One clean bell-strike, from somewhere behind the wall.
  - speaker: NARRATION
    text: The anito is driven back. Not deleted.
  - speaker: NARRATION
    text: The village memory re-anchors at 100%. The people wake like sleepers.
  - speaker: TALA
    text: "Codex written \u2014 SPIRITS. The corruption is not the anito's nature.
      Something older is feeding through it."
  - speaker: NARRATION
    text: "A shrine bell token lies in the tide where it stood. (Codex HERITAGE \u2014
      a key for later.)"
