  m_Script: {fileID: 11500000, guid: 50060b8dc62b41a419acff01334cb145, type: 3}
  m_Name: DLG_SEQ01_TheQuestion
  m_EditorClassIdentifier: Assembly-CSharp::Bayani.Story.DialogueAsset
  lines:
  - speaker: NARRATION
    text: I knew the names of the people who came before me.
  - speaker: NARRATION
    text: But I didn't know their story.
  - speaker: KAI
    text: Why don't we have anything before Lolo?
  - speaker: PARENT
    text: Some things are better left in the past.
  - speaker: KAI
    text: Why?
  - speaker: NARRATION
    text: No answer.
  - speaker: NARRATION
    text: And the more I asked... the more my family wanted me to forget.
