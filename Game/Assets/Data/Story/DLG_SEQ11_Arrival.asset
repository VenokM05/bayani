  m_Script: {fileID: 11500000, guid: 50060b8dc62b41a419acff01334cb145, type: 3}
  m_Name: DLG_SEQ11_Arrival
  m_EditorClassIdentifier: Assembly-CSharp::Bayani.Story.DialogueAsset
  lines:
  - speaker: NARRATION
    text: "War drums. The beach at sunrise \u2014 the recorded day, exactly as the
      archive rebuilt it."
  - speaker: NARRATION
    text: Kai tries to help their ancestor. The battle is chaotic and enormous and
      utterly real.
  - speaker: NARRATION
    text: 'And then Kai sees what no history book records: above the tideline, a
      shape eating the battle itself. Warriors flicker where it passes. The cannon-smoke
      remembers going the wrong way.'
  - speaker: KAI
    text: "\u2026only I can see it. Why can only I see it?"
  xpReward: 300
