  m_Script: {fileID: 11500000, guid: 50060b8dc62b41a419acff01334cb145, type: 3}
  m_Name: DLG_SEQ10B_Intro
  m_EditorClassIdentifier: Assembly-CSharp::Bayani.Story.DialogueAsset
  lines:
  - speaker: NARRATION
    text: Before dawn, the stability beneath the village collapses. Not naturally.
      Something down there is feeding.
  - speaker: NARRATION
    text: "In the cave under the shore, Kai finds it: an anito \u2014 a guardian
      image of the village \u2014 inverted, gnawing the memory of the people it once
      protected."
  - speaker: KAI
    text: "You're one of them\u2026 what did they do to you?"
  - speaker: NARRATION
    text: It answers by coming.
  xpReward: 250
  objectiveText: Find what is eating the nest under the shore
  autoTrack: 1
