  m_Script: {fileID: 11500000, guid: 50060b8dc62b41a419acff01334cb145, type: 3}
  m_Name: DLG_SEQ07B_Rescue
  m_EditorClassIdentifier: Assembly-CSharp::Bayani.Story.DialogueAsset
  lines:
  - speaker: NARRATION
    text: The elder's blade finds the shadow. It unravels like smoke pulled out of
      a flame.
  - speaker: VILLAGER
    text: Limot.
  - speaker: NARRATION
    text: That which is forgotten.
  - speaker: NARRATION
    text: The Limot are what memory becomes when it is eaten. They swarm where the
      past is being forgotten.
  - speaker: NARRATION
    text: And the artifact answered to Kai's blood. This is the first proof it chose
      him.
