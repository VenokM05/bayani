  m_Script: {fileID: 11500000, guid: 50060b8dc62b41a419acff01334cb145, type: 3}
  m_Name: DLG_SEQ08_TheName
  m_EditorClassIdentifier: Assembly-CSharp::Bayani.Story.DialogueAsset
  lines:
  - speaker: NARRATION
    text: In the days that follow, Kai hears a name over and over.
  - speaker: TRADER
    text: Humabon.
  - speaker: NARRATION
    text: Then another name, spoken lower, near the war canoes.
  - speaker: WARRIOR
    text: Lapu-Lapu.
  - speaker: KAI
    text: Mactan.
  - speaker: NARRATION
    text: History is moving toward that battle. Kai wants to stop it.
  - speaker: ELDER
    text: You speak as if you already know tomorrow.
  - speaker: KAI
    text: I do.
  - speaker: ELDER
    text: Then perhaps you should be afraid of tomorrow.
