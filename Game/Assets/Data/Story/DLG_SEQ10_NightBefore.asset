  m_Script: {fileID: 11500000, guid: 50060b8dc62b41a419acff01334cb145, type: 3}
  m_Name: DLG_SEQ10_NightBefore
  m_EditorClassIdentifier: Assembly-CSharp::Bayani.Story.DialogueAsset
  lines:
  - speaker: KAI
    text: Are you afraid?
  - speaker: WARRIOR
    text: Of course.
  - speaker: KAI
    text: Then why stay?
  - speaker: WARRIOR
    text: Because courage isn't the absence of fear.
  - speaker: WARRIOR
    text: It is deciding what matters more.
  - speaker: NARRATION
    text: Kai looks toward the village. Families. Children. Elders. Warriors.
  - speaker: KAI
    text: This isn't a page in a textbook. These are people's lives.
