# Auto detect text files and perform LF normalization
* text=auto

# ==============================
# Git LFS — binary game assets
# (set up BEFORE the first .fbx/.png commit; see content/_asset_needs.md)
# ==============================

# 3D models & animation
Game/Assets/**/*.fbx   filter=lfs diff=lfs merge=lfs -text
Game/Assets/**/*.glb   filter=lfs diff=lfs merge=lfs -text
Game/Assets/**/*.FBX   filter=lfs diff=lfs merge=lfs -text

# Textures & images
Game/Assets/**/*.png   filter=lfs diff=lfs merge=lfs -text
Game/Assets/**/*.jpg   filter=lfs diff=lfs merge=lfs -text
Game/Assets/**/*.jpeg  filter=lfs diff=lfs merge=lfs -text
Game/Assets/**/*.tga   filter=lfs diff=lfs merge=lfs -text
Game/Assets/**/*.psd   filter=lfs diff=lfs merge=lfs -text
Game/Assets/**/*.exr   filter=lfs diff=lfs merge=lfs -text

# Audio
Game/Assets/**/*.wav   filter=lfs diff=lfs merge=lfs -text
Game/Assets/**/*.ogg   filter=lfs diff=lfs merge=lfs -text
Game/Assets/**/*.mp3   filter=lfs diff=lfs merge=lfs -text
Game/Assets/**/*.aiff  filter=lfs diff=lfs merge=lfs -text

# Fonts & video
Game/Assets/**/*.ttf   filter=lfs diff=lfs merge=lfs -text
Game/Assets/**/*.otf   filter=lfs diff=lfs merge=lfs -text
Game/Assets/**/*.mp4   filter=lfs diff=lfs merge=lfs -text

# Unity YAML text assets — mergeable, must stay in plain Git
*.meta        merge=unityyamlmerge eol=lf
*.unity       merge=unityyamlmerge eol=lf
*.prefab      merge=unityyamlmerge eol=lf
*.asset       merge=unityyamlmerge eol=lf
*.physicMaterial merge=unityyamlmerge eol=lf

# Design docs & content are plain text (never LFS)
*.md text
docs/** text
content/** text

# ...EXCEPT binaries parked under content/ — never eol-convert them,
# and LFS them too (Game/Assets is the canonical home; this is a safety net).
content/**/*.fbx  filter=lfs diff=lfs merge=lfs -text
content/**/*.FBX  filter=lfs diff=lfs merge=lfs -text
content/**/*.glb  filter=lfs diff=lfs merge=lfs -text
content/**/*.png  filter=lfs diff=lfs merge=lfs -text
content/**/*.jpg  filter=lfs diff=lfs merge=lfs -text
content/**/*.jpeg filter=lfs diff=lfs merge=lfs -text
content/**/*.tga  filter=lfs diff=lfs merge=lfs -text
content/**/*.psd  filter=lfs diff=lfs merge=lfs -text
content/**/*.wav  filter=lfs diff=lfs merge=lfs -text
content/**/*.ogg  filter=lfs diff=lfs merge=lfs -text
content/**/*.mp3  filter=lfs diff=lfs merge=lfs -text

# Binary files must never be treated as text
*.dll binary
*.exe binary
*.fbx binary -text
*.FBX binary -text
*.png binary -text
*.jpg binary -text
